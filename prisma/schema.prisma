generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  password      String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  creditCards   CreditCard[]
  paymentPlans  PaymentPlan[]

  @@index([email])
}

model CreditCard {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String          // Ej: "Visa", "MasterCard"
  balance       Float           // Saldo actual
  interestRate  Float           // Tasa de interés anual regular (%)
  minPayment    Float?          // Pago mínimo mensual
  limit         Float?          // Límite de crédito

  // Oferta promocional (ej: transferencia de balance)
  hasPromoOffer    Boolean      @default(false)
  promoTransferFee Float?       // Costo de transferencia (% del balance, ej: 3.5)
  promoRate        Float?       // APR promocional (ej: 0 para 0%)
  promoMonths      Int?         // Duración del período promocional en meses

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  paymentItems  PaymentItem[]

  @@unique([userId, name])
  @@index([userId])
}

model PaymentPlan {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                String
  strategy            String          // "avalanche" | "snowball"
  totalDebt           Float
  totalTransferFees   Float           @default(0)
  totalInterest       Float
  monthlyPayment      Float
  estimatedMonths     Int
  savingsVsMinPayment Float

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  paymentItems  PaymentItem[]

  @@index([userId])
}

model PaymentItem {
  id            String          @id @default(cuid())
  creditCardId  String
  creditCard    CreditCard      @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  planId        String
  plan          PaymentPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  month         Int             // Mes del plan (1, 2, 3...)
  principalPayment Float        // Cantidad pagada al principal
  interestPayment Float         // Cantidad de interés
  totalPayment  Float           // Total pagado en el mes
  remainingBalance Float         // Saldo restante después del pago

  @@unique([creditCardId, planId, month])
  @@index([creditCardId])
  @@index([planId])
}
